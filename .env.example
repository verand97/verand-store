# Root-level shared environment example for Verand Store.
# Copy to backend/.env and frontend/.env.local as needed.

# --- Backend (Laravel) ---
APP_NAME="Verand Store"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=verand_store
DB_USERNAME=root
DB_PASSWORD=

# Midtrans (kosong = stub gateway)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=

# Transaction queue: sync | kafka
TRANSACTION_QUEUE_DRIVER=sync
KAFKA_BROKERS=127.0.0.1:9092

# AI: rule | remote
AI_MODE=rule
AI_SERVICE_URL=http://localhost:8001

# Game integration APIs (kosong = stub)
GAME_VOUCHER_API_URL=
GENSHIN_API_URL=
HSR_API_URL=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
